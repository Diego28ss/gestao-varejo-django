# Configurações de Segurança do Django
SECRET_KEY=django-insecure-sua-chave-privada-e-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Configuração do Banco de Dados (SQLite local por padrão)
