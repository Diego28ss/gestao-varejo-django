# ==========================================
# BANCOS DE DADOS E BACKUPS (BLOQUEADOS)
# ==========================================
# Proteção estrita: Impede que o banco local sobreponha o banco de produção no PythonAnywhere!
*.db
*.sqlite3
dados/*.db
backup dados/
backup\ dados/

# ==========================================
# PYTHON E AMBIENTES VIRTUAIS (BLOQUEADOS)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/

# ==========================================
# IDEs E SISTEMAS OPERACIONAIS
# ==========================================
.idea/
.vscode/
.DS_Store
Thumbs.db

# ==========================================
# DJANGO (ARQUIVOS DINÂMICOS E SEGURANÇA)
# ==========================================
media/
staticfiles/
.env
